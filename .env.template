# QBF Logic System Configuration Template
# Copy this file to .env and fill in your values

# ======================
# LLM API Configuration
# ======================

# OpenAI API Key (recommended)
OPENAI_API_KEY=your_openai_api_key_here

# Alternative LLM providers (uncomment and use one)
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GEMINI_API_KEY=your_gemini_key_here

# Default LLM provider
DEFAULT_LLM_PROVIDER=openai

# Default model name
DEFAULT_MODEL=gpt-3.5-turbo

# ======================
# TweetyProject Configuration
# ======================

# Path to TweetyProject JAR file
TWEETY_JAR_PATH=org.tweetyproject.logics.qbf-1.28-with-dependencies.jar

# ======================
# System Settings
# ======================

# Solver timeout in seconds
SOLVER_TIMEOUT=30

# Maximum API retries
MAX_RETRIES=3

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO